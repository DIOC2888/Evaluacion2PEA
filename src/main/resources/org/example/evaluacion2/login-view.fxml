<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="326.0" prefWidth="467.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.evaluacion2.controller.LoginController">
   <children>
      <Label layoutX="82.0" layoutY="82.0" text="Usuario:" />
      <Label layoutX="167.0" layoutY="28.0" text="Inicio de Sesión">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="82.0" layoutY="143.0" text="Contraseña:" />
      <PasswordField fx:id="pwdPassword" layoutX="181.0" layoutY="139.0" />
      <TextField fx:id="txtUsuarip" layoutX="182.0" layoutY="78.0" />
      <Button fx:id="btnIngresar" layoutX="182.0" layoutY="227.0" mnemonicParsing="false" onAction="#ingresarVentanaPrincipal" text="Ingresar" />
      <Button fx:id="btnCerrar" layoutX="288.0" layoutY="227.0" mnemonicParsing="false" onAction="#cerrarLogin" text="Cerrar" />
   </children>
</AnchorPane>
